# Porta da API (o front compilado é servido pelo mesmo processo)
PORT=3333

# Caminho do banco SQLite
DATABASE_PATH=./data/gsti.sqlite

# Segredo de assinatura dos tokens de sessão — obrigatório em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Diretório com as planilhas de origem usadas pela carga inicial (npm run seed)
DADOS_ORIGEM=./dados-origem

# Credenciais criadas pela carga inicial
SEED_NOME=Gestor de TI
SEED_EMAIL=gestor@gsti.local
SEED_SENHA=troque-esta-senha
