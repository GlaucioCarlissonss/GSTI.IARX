# Porta da API (o front compilado é servido pelo mesmo processo)
PORT=3333

# Caminho do banco SQLite
DATABASE_PATH=./data/gsti.sqlite

# Segredo de assinatura dos tokens de sessão — obrigatório em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Auto-cadastro. A primeira conta sempre pode ser criada pela tela; depois
# disso, deixe 'false' para que novos usuários entrem por convite de um gestor.
REGISTRO_ABERTO=false

# Diretório com as planilhas de origem usadas pela carga inicial (npm run seed)
DADOS_ORIGEM=./dados-origem

# Interface de rede. Por padrão a aplicação só atende nesta máquina. Para
# expor à rede, use HOST=0.0.0.0 — e coloque um proxy reverso com HTTPS na
# frente, porque a aplicação não termina TLS por conta própria.
HOST=127.0.0.1

# Credenciais da conta criada pela carga inicial (npm run seed).
# Sem SEED_SENHA, o script sorteia uma senha e a imprime uma única vez.
SEED_NOME=Gestor de TI
SEED_EMAIL=gestor@gsti.local
# SEED_SENHA=

# Integração com os sistemas de suporte (N8N → SaaS).
# Segredo compartilhado exigido no header X-Webhook-Secret dos endpoints
# /api/webhooks/ostick/tickets e /api/webhooks/bitrix24/tickets.
# Sem este valor os endpoints respondem 503: um deploy que esqueceu a variável
# não pode virar uma porta sem tranca.
WEBHOOK_SECRET=

# Teto de chamadas por minuto, por IP, nos webhooks (padrão 600).
WEBHOOK_RATE_LIMIT=600
